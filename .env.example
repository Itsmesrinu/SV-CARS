# Sri Venkateshwara Cars — environment template
#
# Copy this file to `.env.local` (or `.env`) and fill in the real values.
# Both filenames are gitignored; this template is the only env file in git,
# so it must contain PLACEHOLDERS ONLY — never a real credential.
#
# Who reads what:
#   - Vite reads `.env` / `.env.local` and exposes ONLY `VITE_`-prefixed vars to the browser.
#   - The API (`scripts/dev-server.ts`) loads `.env.local` first, then `.env`, via dotenv.
#   - On Vercel, set every var below in Project Settings → Environment Variables.

# --- server only ---

# DATABASE_URL: Neon pooled connection string.
# neon.tech → your project → Connect → "Pooled connection". Keep `?sslmode=require`.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# JWT_SECRET: signing key for the `sv_session` admin cookie (HS256).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it invalidates every existing admin session.
JWT_SECRET=<64 hex chars>

# CLOUDINARY_CLOUD_NAME: Cloudinary dashboard → Programmable Media → API Keys.
CLOUDINARY_CLOUD_NAME=

# CLOUDINARY_API_KEY: same dashboard page. Sent to Cloudinary by the browser as part of
# a signed upload, so it is semi-public — but keep it in env so rotation is not a code change.
CLOUDINARY_API_KEY=

# CLOUDINARY_API_SECRET: same dashboard page → "View API Keys".
# SERVER-ONLY. This var must never gain a `VITE_` prefix, never be imported from anything
# under `src/`, and never be committed. It is used only by the API's upload signing
# (`server/lib/cloudinary.ts`) and the local image migration script.
CLOUDINARY_API_SECRET=

# --- exposed to the browser (safe: cloud name is public) ---

# VITE_CLOUDINARY_CLOUD_NAME: same value as CLOUDINARY_CLOUD_NAME above.
# Deliberately public: the client-side URL builder (`src/lib/cloudinary.ts`) needs it to
# construct https://res.cloudinary.com/<cloud name>/image/upload/... so it appears in
# every image URL on the live site. A cloud name grants no access on its own.
VITE_CLOUDINARY_CLOUD_NAME=
